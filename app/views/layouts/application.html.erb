<!DOCTYPE html>
<html lang="en">
<head>
  <% turbo_refreshes_with method: :morph, scroll: :preserve %>
  <%= render "layouts/head",
             title: content_for(:title) || "Twine – Get a free linktree",
             description: "One link for everything you share. Free, simple, and made in Norway.",
             image_url: image_url("logo.png") %>
  <%= javascript_importmap_tags %>
</head>

<body class="min-h-screen bg-[#fdf9f5] text-stone-900 antialiased">
  <header class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5">
    <%= link_to root_path do %>
      <%= image_tag "logo.png", alt: "Twine", class: "h-8 w-auto" %>
    <% end %>

    <nav class="flex items-center gap-2">
      <% if authenticated? %>
        <%= button_to "Log out", session_path, method: :delete, class: "button button-secondary" %>
      <% else %>
        <%= link_to "Log in", new_session_path, class: "button button-secondary" %>
        <%= link_to "Sign up free", new_registration_path, class: "button button-primary" %>
      <% end %>
    </nav>
  </header>

  <main class="mx-auto max-w-5xl px-4 pb-16">
    <%= yield %>
  </main>

  <footer class="mx-auto max-w-5xl px-4 pb-10 text-center text-sm text-stone-500">
    🇳🇴 Made in Norway · <%= mail_to "hey@twine.no", class: "underline" %>
  </footer>

  <div class="dynamic-flash-container" data-turbo-temporary>
    <%= render "flash" %>
  </div>
</body>
</html>
