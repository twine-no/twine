<%# locals: (options:, content:) %>
<div class="card <%= options[:class] %> rounded-2xl bg-white border border-[#e8e0d8] shadow-[0_2px_10px_rgba(0,0,0,0.05)] mb-3 divide-y divide-[#e8e0d8]">
  <% if options[:title].present? %>
    <div class="pb-2">
      <h3 class="text-base font-semibold text-gray-900"><%= options[:title] %></h3>
    </div>
  <% end %>

  <div>
    <%= content %>
  </div>
</div>
