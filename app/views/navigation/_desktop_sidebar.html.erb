<div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
  <div class="flex grow flex-col gap-y-5 overflow-y-auto bg-[#2E282A] px-6 pb-4">
    <div class="flex h-16 shrink-0 items-center">
      <span class="text-white font-semibold text-base"><%= Current.platform.name %></span>
    </div>

    <% if admin_page? %>
      <%= render 'navigation/admin_sidebar_options' %>
    <% else %>
      <%= render 'navigation/member_sidebar_options' %>
    <% end %>

    <div data-controller="dropdown" class="relative -mx-2 mt-auto border-t border-white/10 pt-4">
      <button type="button"
              data-action="click->dropdown#toggle"
              class="flex w-full items-center gap-x-3 rounded-md px-2 py-2 text-sm font-medium text-gray-400 hover:bg-white/10 hover:text-white transition-colors"
              aria-expanded="false">
        <%= svg_tag 'icons/mingcute/user_4_line', class: 'size-5 shrink-0' %>
        <span class="flex-1 text-left">Account</span>
        <%= svg_tag 'icons/caret_down.svg', class: 'size-4 shrink-0' %>
      </button>

      <dialog
        data-dropdown-target="menu"
        class="absolute bottom-full mb-1 left-0 right-0 rounded-md bg-white py-2 mx-0 shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
        role="menu"
        tabindex="-1">

        <% Current.user.memberships.with_admin_rights.includes(:platform).each do |membership| %>
          <%= button_to session_path,
                        target: "_top",
                        method: :patch,
                        params: { session: { platform_id: membership.platform_id } },
                        class: "block px-3 py-1 text-sm/6 text-left text-gray-900 hover:bg-gray-50 w-full" do %>
            <%= "🧶" if membership.platform == Current.platform %> <%= membership.platform.name %>
          <% end %>
          <hr class="text-gray-300">
        <% end %>

        <%= button_to "Log out",
                      session_path,
                      method: :delete,
                      class: "block px-3 py-1 text-sm/6 text-left text-gray-900 hover:bg-gray-50 w-full" %>
      </dialog>
    </div>
  </div>
</div>
