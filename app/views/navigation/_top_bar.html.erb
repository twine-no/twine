<%#= raise "fix dropdown with: https://daisyui.com/components/dropdown/" %>

<div class="flex flex-1 gap-x-4 self-stretch lg:gap-x-6 bg-base-200 justify-end py-3 px-4 sm:px-6 lg:px-8">
  <button class="btn" popovertarget="popover-1" style="anchor-name:--anchor-1">
    <%= svg_tag 'icons/caret_down.svg', class: 'size-3 text-gray-400' %>
  </button>
  <ul class="dropdown menu min-w-72 rounded-box bg-base-100 shadow-sm"
      popover id="popover-1" style="position-anchor:--anchor-1">
    <% Current.user.memberships.with_admin_rights.includes(:platform).each do |membership| %>
      <li>  <%= button_to session_path,
                          target: "_top",
                          method: :patch,
                          params: { session: { platform_id: membership.platform_id } },
                          form_class: "flex cursor-pointer",
                          class: "w-full cursor-pointer" do
      %>
          <%= "🧶" if membership.platform == Current.platform %> <%= membership.platform.name %>
        <% end %>
      </li>
    <% end %>
    <li>
      <%= button_to "Log out",
                    session_path,
                    target: "_top",
                    method: :delete,
                    form_class: "flex",
                    class: "w-full cursor-pointer"
      %>
    </li>
  </ul>
</div>


