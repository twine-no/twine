<% content_for :title, "New password | Twine" %>

<div class="auth-card">
  <h1 class="auth-title">Choose a new password</h1>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="form-group">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :password_confirmation, "Repeat new password" %>
      <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", class: "form-control" %>
    </div>

    <%= form.submit "Update password", class: "button button-primary button-xl mt-2 w-full" %>
  <% end %>
</div>
