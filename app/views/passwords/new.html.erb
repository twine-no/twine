<% content_for :title, "Forgot password | Twine" %>

<div class="auth-card">
  <h1 class="auth-title">Forgot your password?</h1>

  <%= form_with url: passwords_path do |form| %>
    <div class="form-group">
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", class: "form-control" %>
    </div>

    <%= form.submit "Email reset instructions", class: "button button-primary button-xl mt-2 w-full" %>
  <% end %>
</div>
