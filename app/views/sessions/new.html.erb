<% content_for :title, "Log in | Twine" %>

<div class="auth-card">
  <h1 class="auth-title">Log in</h1>

  <%= form_with url: session_path do |form| %>
    <div class="form-group">
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, maxlength: 72, autocomplete: "current-password", class: "form-control" %>
    </div>

    <%= form.submit "Log in", class: "button button-primary button-xl mt-2 w-full" %>
  <% end %>

  <p class="auth-footnote">
    <%= link_to "Forgot password?", new_password_path, class: "underline" %>
  </p>

  <p class="auth-footnote">
    New here? <%= link_to "Get a free linktree", new_registration_path, class: "underline" %>
  </p>
</div>
